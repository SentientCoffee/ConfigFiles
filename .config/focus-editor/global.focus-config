[13]  # Version number. Do not delete.

# Build command regexes:
# jai:    ^(?P<file>.*):(?P<line>\d+),(?P<col>\d+): (?P<type>Error|Warning|Info|...):* (?P<msg>.*)|^(?P<msg1>.*error LNK.*)
# msvc:   ^(?P<file>.*)\((?P<line>\d+),?(?P<col>\d+)?\)[ ]?: (?P<type>error|warning) (?P<msg>.*)$
# golang: ^(?P<file>.*):(?P<line>\d+):(?P<col>\d+): (?P<msg>.*)$
# gcc:    ^(?P<file>.*):(?P<line>\d+):(?P<col>\d+): (?P<type>error|warning): (?P<msg>.*) (\[(?P<msg1>.*)\])?$
# odin:   ^(?P<file>.*)\((?P<line>\d+):(?P<col>\d+)\) (?P<msg>.*)

[[workspace]]
# These directories and files will be scanned when a workspace is opened so that search etc. works.
# Example:
# C:/projects/my-project  # <- the first directory in the list becomes the working directory
# C:/jai
# src  # <- this would be relative to the config file location

[ignore]
# Files and directories matching the following wildcards will not be loaded or descended into
# Example:
# *.js - will ignore all files with a '.js' extension
# tmp* - will ignore any files or directories which start with 'tmp'
# C:/project/dirname/** - will ignore everything under `dirname`
# C:/project/dirname/*  - will ignore all files under `dirname`, but not recursively
.svn
.git
.github
__pycache__
*woff?
*so.*
*.spv

[allow]
# Files and directories matching the wildcards in this section will be loaded, even if they are ignored in the previous section.
# NOTE: known binary file extensions are ignored by default (*.exe, *.obj etc.). If this is not what you want, you can explicitly allow them here.
.focus-*
*.gitattributes
*.gitignore

[file associations]
# Optional file associations in the format `<wildcard1> <wildcard2> ... : <language>`
# Example:
# *.hpp *.hh *.h : cpp
# todo.txt : todo

.bash* .zsh* .zprofile : shell
*.yaml *.yml : python  # Mega hack but it's serviceable?


[[settings]]

auto_close_brackets:                             false
auto_surround_with_brackets_and_quotes:          true
build_panel_stays_in_one_place:                  false                     # if false, the build panel will flip to the inactive pane in two pane layouts
build_panel_line_wrap_always_on:                 true
can_cancel_go_to_line:                           true
color_preview_popup:                             enabled                   # options: enabled, minimized, disabled
colored_titlebar:                                true   # Windows 11+ only
copy_whole_line_without_selection:               true
cursor_as_block:                                 false
dark_titlebar:                                   true
show_paste_effect:                               true
detect_indentation:                              true                      # if true, existing files will be scanned to detect indentation, new files will use the `indent_using` and `tab_size` settings
disable_file_open_close_animations:              false
disable_viewport_chasing_cursor_near_the_edge:   false                     # if true, the viewport will not scroll smoothly to cursor when you move the cursor outside it by small amounts
double_shift_to_search_in_workspace:             false
draw_indent_guides:                              true
hide_mouse_when_typing:                          true
highlight_line_with_cursor:                      true
highlight_matching_brackets:                     false
highlight_selection_occurrences:                 true
insert_final_newline_on_save:                    true
indent_using:                                    spaces                    # options: spaces, tabs
line_wrap_is_on_by_default:                      false
load_most_recent_project_on_start:               false
maximize_on_start:                               false
open_on_the_biggest_monitor:                     false
persist_local_search_results:                    false                     # if true, search results will stay highlighted and you have to dismiss them using the `escape` action
prefer_system_file_dialogs:                      false
projects_sorting_order:                          most_recent_first         # options: most_recent_first, alphabetical, alphabetical_no_case
save_all_file_backed_buffers_on_build:           false
save_current_buffer_on_build:                    true
scroll_beyond_last_line:                         true
search_is_case_sensitive_when_uppercase_present: false
status_bar_show_cursors_off_screen:              true
show_line_numbers:                               true
status_bar_show_indentation:                     true
status_bar_show_line_col:                        true
status_bar_show_selected_text_length:            true
smooth_scrolling:                                true
status_bar_position:                             bottom
strip_trailing_whitespace_on_save:               except_lines_with_cursor  # options: all, except_lines_with_cursor, disabled

build_panel_width_percent:                       45
build_panel_height_percent:                      67
cursor_blink_time_in_seconds:                    5
editor_history_size:                             1024
line_height_scale_percent:                       110
max_editor_width:                                -1
show_ruler_at_column:                            0
tab_size:                                        4
window_width:                                    -1
window_height:                                   -1

# NOTE: some settings can be specified for a subset of files, based on their language or a wildcard,
# for example:
# [file: <wildcard1>, <wildcard2>, ...]
# [lang: golang, cpp, c, ...]

[file: *.md, *.txt]
line_wrap_is_on_by_default:                      true
draw_indent_guides:                              false

[[linux]]

# scaling_factor:                         1.25

[[keymap]]

# - The first matching combination will be used, so order matters

[editors]   # <- this means that the following key combos will apply only when editing text

# Key combination           Action
Ctrl-Shift-D                select_word_or_create_another_cursor
Ctrl-K Ctrl-D               select_all_occurrences

# These shortcuts can be annoying to accidentally use, so they are commented out by default
# Shift-Backspace             delete_line_and_go_up
# Shift-Delete                delete_line

Ctrl-D                      duplicate_lines

Alt-ArrowUp                 move_selected_lines_up
Alt-ArrowDown               move_selected_lines_down

Ctrl-J                      join_lines
Ctrl-Shift-J                join_lines_no_spaces_in_between

Tab                         indent_or_go_to_next_tabstop
Shift-Tab                   unindent
Ctrl-Tab                    autoindent_region

Ctrl-]                      indent
Ctrl-[                      unindent

Ctrl-S                      save
Ctrl-Shift-S                save_as
Ctrl-K Ctrl-S               save_all

Alt-Minus                   move_to_previous_buffer
Alt-=                       move_to_next_buffer
{Shift}-Alt-_               move_to_previous_editor_history
Shift-Alt-Plus              move_to_next_editor_history

Ctrl-/                      toggle_comment
Ctrl-{Shift}-?              toggle_block_comment

Alt-C                       move_cursor_to_viewport_center

Ctrl-{Shift}-ArrowUp        move_up_to_empty_line
Ctrl-{Shift}-ArrowDown      move_down_to_empty_line

Escape                      escape

Enter                       break_line
Ctrl-Enter                  new_line_below_without_breaking
Ctrl-Shift-Enter            new_line_above_without_breaking

Alt-ArrowLeft               switch_to_left_editor
Alt-ArrowRight              switch_to_right_editor
Alt-.                       switch_to_other_editor
Shift-Alt-.                 duplicate_editor

Ctrl-Alt-ArrowLeft          move_editor_to_the_left
Ctrl-Alt-ArrowRight         move_editor_to_the_right

# Ctrl-Alt-ArrowUp            scroll_viewport_up_fast
# Ctrl-Alt-ArrowDown          scroll_viewport_down_fast
# Ctrl-Alt-ArrowLeft          scroll_viewport_left
# Ctrl-Alt-ArrowRight         scroll_viewport_right

Ctrl-N                      create_new_file
Ctrl-Shift-N                create_new_file_on_the_side

Shift-Alt-ArrowUp           create_cursor_above
Shift-Alt-ArrowDown         create_cursor_below
Ctrl-Alt-=                  align_cursors
Ctrl-Alt-I                  add_cursors_to_line_ends
Ctrl-Shift-Alt-I            add_cursors_to_line_starts

Ctrl-K Ctrl-L               toggle_line_wrap

# Added after migration to version [13]
Ctrl-U                      change_case_cycle
Ctrl-R                      revert_select_word_or_create_another_cursor
Ctrl-Y                      move_selection_to_next_word

[open file dialog]

Escape                      close_dialog

Enter                       open_entry_in_place
Ctrl-Enter                  open_entry_on_the_side
Alt-ArrowLeft               open_entry_on_the_left
Alt-ArrowRight              open_entry_on_the_right
Shift-Enter                 open_entry_in_explorer

Tab                         open_directory
ArrowRight                  open_directory

Backspace                   pop_directory
ArrowLeft                   pop_directory

[search dialog]

Escape                      close_dialog

Enter                       open_entry_in_place
Ctrl-Enter                  open_entry_on_the_side
Alt-ArrowLeft               open_entry_on_the_left
Alt-ArrowRight              open_entry_on_the_right

Alt-C                       toggle_case_sensitive
Alt-W                       toggle_whole_word
Alt-E                       toggle_regex_search

Tab                         go_to_next_input
Shift-Tab                   go_to_previous_input

[common]

# Common key combos may be used as a fallback if they are not defined in more specific sections.
# For example, if "move_up" is not defined in [editors], the one in the [common] section will be matched.
Alt-F4                      quit

Ctrl-,                      open_global_config
Ctrl-{Shift}-<              open_project_config

Ctrl-Shift-P                show_commands
Ctrl-Alt-P                  switch_to_project
Ctrl-K Ctrl-W               close_project

Alt-F                       search_in_buffer
Ctrl-F                      search_in_buffer_dropdown_mode
Ctrl-Shift-F                search_in_project

Ctrl-P                      open_file_by_name
Ctrl-O                      navigate_to_file_from_root
Ctrl-Shift-O                navigate_to_file
Ctrl-Tab                    switch_between_open_files

Ctrl-L                      go_to_line

Ctrl-X                      cut
Ctrl-C                      copy
Ctrl-V                      paste

Ctrl-Z                      undo
Ctrl-Shift-Z                redo

Ctrl-Shift-D                select_word
Ctrl-A                      select_all

Ctrl-W                      close_current_editor
Ctrl-Shift-W                close_other_editor

Ctrl-Shift-E                toggle_expand

{Shift}-ArrowUp             move_up
{Shift}-PageUp              move_up_one_page
Ctrl-Alt-ArrowUp            move_up_fast

{Shift}-ArrowDown           move_down
{Shift}-PageDown            move_down_one_page
Ctrl-Alt-ArrowDown          move_down_fast

{Shift}-ArrowLeft           move_left
Ctrl-{Shift}-ArrowLeft      move_left_by_character_type
{Shift}-Alt-ArrowLeft       move_left_by_character_type_fast

{Shift}-ArrowRight          move_right
Ctrl-{Shift}-ArrowRight     move_right_by_character_type
{Shift}-Alt-ArrowRight      move_right_by_character_type_fast

{Shift}-Home                jump_to_line_start
{Shift}-End                 jump_to_line_end
Ctrl-{Shift}-Home           jump_to_file_start
Ctrl-{Shift}-PageUp         jump_to_file_start
Ctrl-{Shift}-End            jump_to_file_end
Ctrl-{Shift}-PageDown       jump_to_file_end

{Shift}-Backspace           delete_left_char
{Shift}-Delete              delete_right_char
Ctrl-Backspace              delete_left_by_character_type
Ctrl-Delete                 delete_right_by_character_type
Ctrl-Shift-Delete           delete_to_end_of_line
Ctrl-Shift-Backspace        delete_to_start_of_line
{Shift}-Alt-Backspace       delete_left_by_character_type_fast
{Shift}-Alt-Delete          delete_right_by_character_type_fast

Ctrl-=                      increase_font_size
Ctrl-Minus                  decrease_font_size
Ctrl-0                      reset_font_size_to_default
Ctrl-MouseMiddle            reset_font_size_to_default

Ctrl-B                      build_panel_toggle
F8                          go_to_next_build_error
Ctrl-F8                     go_to_next_build_error_on_the_side
Shift-F8                    go_to_previous_build_error
Shift-Ctrl-F8               go_to_previous_build_error_on_the_side

F11                         toggle_fullscreen
Ctrl-Shift-Alt-N            open_another_editor_instance

